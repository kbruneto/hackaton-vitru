# Usado apenas em `vite build`. Tem prioridade sobre o .env comum.
#
# TROQUE a URL abaixo pela do backend publicado, senao o site em producao vai
# tentar falar com o localhost de quem abrir a pagina.
#
# Alternativa: definir VITE_API_URL como variavel de ambiente no painel da
# Vercel. Variavel de ambiente tem prioridade sobre qualquer arquivo .env.

VITE_API_URL=https://TROQUE-PELA-URL-DO-BACKEND.onrender.com

# Qual aluno representa o usuario logado, enquanto nao existe autenticacao.
