# Copie para .env e preencha com as chaves do seu projeto Supabase.
# Dashboard > Project Settings > API Keys
# NUNCA comite o .env preenchido.

SUPABASE_URL=https://<project-ref>.supabase.co

# Chave publica (pode ir para o browser, respeita RLS)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta (SO no servidor, ignora RLS)
SUPABASE_SECRET_KEY=sb_secret_...

SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Origem permitida no CORS (o dev server do Vite)
CORS_ORIGIN=http://localhost:5173

PORT=3000
